# ─────────────────────────────────────────────────────────────────────────────
# audio-analysis-service — production environment.
#
# Copy to /opt/audio-analysis/.env.production on the VPS, fill it in, and
# chmod 600 it. This file is the one thing the deploy script never overwrites.
#
# It is NOT the same file as the repository's .env.example. That one describes a
# developer's machine, and includes TEST_DATABASE_URL and host port mappings
# that have no meaning here.
# ─────────────────────────────────────────────────────────────────────────────

# The public hostname. Must already have an A record pointing at this server, or
# Let's Encrypt's HTTP-01 challenge will fail and Traefik will serve its default
# self-signed certificate instead.
PUBLIC_HOST=audio-analysis.aliasghar.me

# Postgres. Generate the password with:  openssl rand -hex 24
# Hex on purpose — it is substituted into DATABASE_URL below, and a password
# containing :, / or @ silently truncates the connection string.
POSTGRES_USER=audio
POSTGRES_DB=audio_analysis
POSTGRES_PASSWORD=

# Must contain the same password. `postgres` is the compose service name, which
# resolves on the internal bridge network only.
DATABASE_URL=postgresql://audio:PASSWORD_HERE@postgres:5432/audio_analysis?schema=public

# Application configuration. Defaults match the documented behaviour; these are
# here so a change is a file edit rather than an image rebuild.
MAX_UPLOAD_BYTES=52428800
OUTLIER_MIN_SECONDS=5
OUTLIER_MAX_SECONDS=600
LOG_LEVEL=info

# Traefik wiring. These match the instance already running on this host; change
# them only if that instance is reconfigured.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
