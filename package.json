{
  "name": "audio-analysis-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "test": "pnpm --filter @audio/api test",
    "test:unit": "pnpm --filter @audio/api test:unit",
    "test:integration": "pnpm --filter @audio/api test:integration",
    "test:security": "pnpm --filter @audio/api test:security",
    "test:large": "pnpm --filter @audio/api test:large",
    "test:coverage": "pnpm --filter @audio/api test:coverage",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf apps/*/dist apps/*/.next apps/*/coverage apps/*/*.tsbuildinfo",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "db:generate": "pnpm --filter @audio/api db:generate",
    "db:migrate": "pnpm --filter @audio/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @audio/api db:migrate:deploy",
    "db:migrate:test": "pnpm --filter @audio/api db:migrate:test",
    "db:reset": "pnpm --filter @audio/api db:reset",
    "db:studio": "pnpm --filter @audio/api db:studio",
    "infra:up": "docker compose up -d postgres postgres-test",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d postgres postgres-test",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "overrides": {
      "mysql2": ">=3.22.0",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
