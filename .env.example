# ─────────────────────────────────────────────────────────────────────────────
# audio-analysis-service — environment
#
#   cp .env.example .env
#
# Legend:  [REQUIRED] must be set    [OPTIONAL] has a working default
#
# Every key here is declared in apps/api/src/config/env.ts, which is the single
# place the application reads process.env. If a key is not in that schema, the
# application does not use it.
#
# Host ports use the x495 block so this project can run alongside the other
# services on this machine without colliding. See docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Postgres for development and for `docker compose up`.
DATABASE_URL="postgresql://audio:audio@localhost:5495/audio_analysis?schema=public"

# [REQUIRED for tests] A separate, tmpfs-backed Postgres. The integration suite
# truncates tables between cases, so it refuses to run against DATABASE_URL.
TEST_DATABASE_URL="postgresql://audio:audio@localhost:5496/audio_analysis_test?schema=public"

# [OPTIONAL] API server.
API_HOST="0.0.0.0"
API_PORT=4490

# [OPTIONAL] Where uploaded audio is written. Relative paths resolve from the
# api app directory. Content-addressed: <dir>/audio/<aa>/<bb>/<sha256>.mp3
STORAGE_DIR="./storage"

# [OPTIONAL] Upload ceiling in bytes. Enforced by @fastify/multipart, which is
# the only place the limit exists. Default 50 MiB.
MAX_UPLOAD_BYTES=52428800

# [OPTIONAL] Duration outlier window, in seconds. A file is flagged when it is
# shorter than MIN or longer than MAX. These are a documented policy, not a
# discovered truth — see the README.
OUTLIER_MIN_SECONDS=5
OUTLIER_MAX_SECONDS=600

# [OPTIONAL] pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# [OPTIONAL] Web app. NEXT_PUBLIC_* is inlined at BUILD time, so changing this
# for a Docker image means rebuilding, not restarting.
WEB_PORT=3490
# The browser talks to /api/* on its own origin; Next rewrites proxy it here.
API_URL="http://localhost:4490"
