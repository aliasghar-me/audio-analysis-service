{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext + "type": "module" means relative imports carry an explicit
    // `.js` extension, including in the specs. music-metadata is ESM-only,
    // so there is no CommonJS option here.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma.config.ts", "*.config.ts"]
}
