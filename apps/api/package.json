{
  "name": "@audio/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "//files": "What `pnpm deploy --prod` copies into the runtime image. Without this it copies the whole package — specs, vitest configs and the 218 KB test fixture included.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "node scripts/migrate-test-db.js && vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/migrate-test-db.js && vitest run --project integration",
    "test:security": "node scripts/migrate-test-db.js && vitest run --project security",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "node scripts/migrate-test-db.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.1",
    "music-metadata": "^11.15.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.11",
    "form-data": "^4.0.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
